# ==========================================
# APPLICATION
# ==========================================

APP_NAME=MedAI
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE
# ==========================================
# Note: Neon serverless postgres pooled connection string goes here:
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ==========================================
# AI PROVIDERS
# ==========================================
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ==========================================
# FILE UPLOADS & OCR
# ==========================================
UPLOAD_DIR=uploads
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25
FILE_ENCRYPTION_KEY= # Generate using cryptography.fernet.Fernet.generate_key()

OCR_ENABLED=true
TESSERACT_CMD=tesseract
OCR_DPI=300

# ==========================================
# WORKERS
# ==========================================
AUTO_ANALYZE=true

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=password
SMTP_FROM=noreply@medai.com
SMTP_TLS=true
